// Cloudflare Worker for servisheet.com: serves the built app from ./dist and runs
// worker/index.ts only for "/" (landing page or app), /index.html (the app shell the
// service worker caches) and /api/* (the Stripe webhook).
{
  "name": "servisheet",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/index.html", "/api/*"]
  },
  // Secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, SUPABASE_SERVICE_ROLE_KEY)
  // are set in the dashboard; keep anything set there on each deploy.
  "keep_vars": true,
  "observability": { "enabled": true }
}
